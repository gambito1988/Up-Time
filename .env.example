# Obligatorias
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres?sslmode=require
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pon-una-contrasena-segura

# Email (confirmación de cuenta y recuperación de contraseña)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@example.com
SMTP_PASSWORD=pon-la-clave-del-servidor-smtp

# Aviso por email al negocio cuando llega un mensaje de contacto (opcional)
CONTACT_NOTIFY_EMAIL=
# Si están definidas, ese aviso sale por el workflow de n8n "Up Time - Email por webhook" en vez de SMTP
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Datos fiscales para las páginas de Términos y Privacidad (opcional; si no se definen
# se muestran placeholders "[Completar: ...]" que hay que reemplazar antes de publicar)
BUSINESS_LEGAL_NAME=
BUSINESS_CUIT=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=info@uptime.com.ar

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks) para verificar la firma
MERCADOPAGO_WEBHOOK_SECRET=

# Límite de intentos compartido entre workers y que sobrevive a reinicios (Redis).
# En Render ya está resuelto: la instancia "up-time-ratelimit" (Key Value) se conecta
# sola via render.yaml (fromService). En desarrollo local, con un Redis propio:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
